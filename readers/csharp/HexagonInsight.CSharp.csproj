<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# reader (readers/AGENTS.md): opens a target's solution with Roslyn's MSBuild workspace and
    writes the model's code facts (analysis/model.ts, `Code`) as JSON to its output. `read.ts` beside
    it builds and runs it, with its build output in a cache outside the package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

</Project>
